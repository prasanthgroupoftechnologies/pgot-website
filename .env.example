# ==========================================
# PRASANTH GROUP OF TECHNOLOGIES — CONFIG
# ==========================================

# ------------------------------------------
# FRONTEND API BASE URL (Vite / Netlify)
# ------------------------------------------
# Local Dev: Leave empty to use Vite local proxy (/api -> http://localhost:5000)
# Production (Netlify Environment Variables): Set to your deployed backend URL:
# Example: VITE_API_BASE_URL=https://pgot-api.onrender.com
VITE_API_BASE_URL=

# ------------------------------------------
# BACKEND SERVER CONFIG
# ------------------------------------------
PORT=5000

# PostgreSQL Database Connection URL (Mandatory for persistence)
# On Render: Create a PostgreSQL database instance and copy the "Internal Database URL" (or "External Database URL")
# Example: DATABASE_URL=postgresql://pgot_user:password123@dpg-xxxx.oregon-postgres.render.com/pgot_db
# Or local PostgreSQL: postgresql://postgres:postgres@localhost:5432/pgot_db
DATABASE_URL=

# Optional Pool Configuration
DB_POOL_MAX=10
# Set to 'false' if testing against a non-SSL local postgres instance
DATABASE_SSL=

# Official Company Notification Inboxes (Mandatory)
COMPANY_PRIMARY_EMAIL=prasanthgroupoftechnologies@gmail.com
COMPANY_NOTIFICATION_EMAIL=prasanthhealthtech@gmail.com

# ------------------------------------------
# OPTION 1: Resend Email Service (Recommended)
# ------------------------------------------
# 1. Sign up at https://resend.com
# 2. Create an API key in your Resend Dashboard
# 3. Paste the key below:
RESEND_API_KEY=re_your_api_key_here
EMAIL_FROM=PGOT Enquiries <onboarding@resend.dev>

# ------------------------------------------
# OPTION 2: SMTP / Gmail (Alternative)
# ------------------------------------------
# To use Gmail directly:
# 1. Go to your Google Account > Security > 2-Step Verification > App Passwords
# 2. Generate an App Password for "Mail"
# 3. Enter your Gmail address and 16-character App Password below:
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=your_gmail@gmail.com
SMTP_PASS=your_16_char_app_password
