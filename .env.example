# ==========================================
# PRASANTH GROUP OF TECHNOLOGIES — CONFIG
# ==========================================

# ------------------------------------------
# FRONTEND API BASE URL (Vite / Netlify)
# ------------------------------------------
# Local Dev: Leave empty to use the Vite local dev proxy (/api -> http://localhost:5000)
# Production (Netlify Environment Variables): Set to your deployed backend URL:
# Example: VITE_API_BASE_URL=https://pgot-api.onrender.com
VITE_API_BASE_URL=

# ------------------------------------------
# BACKEND SERVER CONFIG
# ------------------------------------------
PORT=5000

# SQLite Database File Path (Optional Override)
# Default is '<project_root>/data/enquiries.db'
# On Render with Persistent Disk: set to e.g. /var/data/enquiries.db
SQLITE_DB_PATH=

# Official Company Notification Inboxes (Mandatory)
COMPANY_PRIMARY_EMAIL=prasanthgroupoftechnologies@gmail.com
COMPANY_NOTIFICATION_EMAIL=prasanthgroupoftechnologies@gmail.com

# ------------------------------------------
# OPTION 1: Resend Email Service (Recommended)
# ------------------------------------------
RESEND_API_KEY=re_your_api_key_here
EMAIL_FROM=PGOT Enquiries <onboarding@resend.dev>

# ------------------------------------------
# OPTION 2: SMTP / Gmail (Alternative)
# ------------------------------------------
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=your_gmail@gmail.com
SMTP_PASS=your_16_char_app_password
